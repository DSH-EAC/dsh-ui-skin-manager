{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eac.github.io/schemas/ui-skin/v1/skin-package.schema.json",
  "title": "DSH EAC UI Skin Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "engines", "contributions", "assets", "integrity"],
  "properties": {
    "apiVersion": {"const": "dsh.eac.ui-skin/v1"},
    "kind": {"const": "SkinPackage"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "name", "author"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "version": {"$ref": "#/$defs/semver"},
        "name": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1}
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "hostProfile"],
      "properties": {
        "manager": {"$ref": "#/$defs/semverRange"},
        "hostProfile": {"$ref": "#/$defs/semverRange"},
        "dsh": {"$ref": "#/$defs/semverRange"}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "range"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "range": {"$ref": "#/$defs/semverRange"}
        }
      }
    },
    "contributions": {"type": "array", "minItems": 1, "items": {"$ref": "./slot-contribution.schema.json"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/safePath"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "integrity": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "semverRange": {"type": "string", "pattern": "^(?:[~^]|>=?|<=?)?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\s+(?:<|<=|>|>=)[0-9]+\\.[0-9]+\\.[0-9]+)?$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
