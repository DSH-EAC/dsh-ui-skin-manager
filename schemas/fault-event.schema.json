{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eac.github.io/schemas/ui-skin/v1/fault-event.schema.json",
  "title": "DSH EAC Skin Fault Event",
  "type": "object",
  "required": ["timestamp", "severity", "errorCode", "message", "correlationId", "generation", "regionOrSlot", "lifecycleStage", "source", "recoverable", "recoveryAction", "bindingState"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "severity": {"enum": ["warning", "error", "fatal"]},
    "errorCode": {"$ref": "./skin-package.schema.json#/$defs/errorCode"},
    "message": {"type": "string"},
    "correlationId": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "regionOrSlot": {"type": "string", "minLength": 1},
    "lifecycleStage": {"type": "string", "minLength": 1},
    "source": {"enum": ["official", "third-party"]},
    "recoverable": {"type": "boolean"},
    "recoveryAction": {"type": "string", "minLength": 1},
    "bindingState": {"type": "string", "minLength": 1},
    "packageId": {"$ref": "./skin-package.schema.json#/$defs/identifier"},
    "packageVersion": {"$ref": "./skin-package.schema.json#/$defs/semver"},
    "packageDigest": {"$ref": "./skin-package.schema.json#/$defs/digest"},
    "control": {"type": "string", "minLength": 1},
    "detail": {"type": "object"}
  },
  "dependentRequired": {
    "packageId": ["packageVersion", "packageDigest"],
    "packageVersion": ["packageId", "packageDigest"],
    "packageDigest": ["packageId", "packageVersion"]
  }
}
