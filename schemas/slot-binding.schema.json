{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eac.github.io/schemas/ui-skin/v1/slot-binding.schema.json",
  "title": "DSH EAC Slot Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "package", "contribution", "generation", "state"],
  "properties": {
    "slot": {"type": "string", "minLength": 1},
    "package": {"$ref": "#/$defs/packageCoordinate"},
    "contribution": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0},
    "state": {"enum": ["staged", "active", "failed", "inactive"]}
  },
  "$defs": {
    "packageCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"$ref": "./skin-package.schema.json#/$defs/identifier"},
        "version": {"$ref": "./skin-package.schema.json#/$defs/semver"},
        "digest": {"$ref": "./skin-package.schema.json#/$defs/digest"}
      }
    }
  }
}
