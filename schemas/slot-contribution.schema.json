{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eac.github.io/schemas/ui-skin/v1/slot-contribution.schema.json",
  "title": "DSH EAC Slot Contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slot", "entry", "assets", "requires", "lifecycle"],
  "properties": {
    "id": {"$ref": "./skin-package.schema.json#/$defs/identifier"},
    "slot": {"type": "string", "minLength": 1},
    "entry": {"$ref": "./skin-package.schema.json#/$defs/safePath"},
    "assets": {"type": "array", "items": {"$ref": "./skin-package.schema.json#/$defs/safePath"}},
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "assets"],
      "properties": {
        "entry": {"$ref": "./skin-package.schema.json#/$defs/safePath"},
        "assets": {"type": "array", "items": {"$ref": "./skin-package.schema.json#/$defs/safePath"}}
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "slotKind", "slotScope"],
      "properties": {
        "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "slotKind": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "slotScope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount", "health", "unmount"],
      "properties": {
        "mount": {"type": "string", "minLength": 1},
        "health": {"type": "string", "minLength": 1},
        "unmount": {"type": "string", "minLength": 1}
      }
    }
  }
}
