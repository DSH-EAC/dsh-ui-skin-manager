{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eac.github.io/schemas/ui-skin/v1/host-profile.schema.json",
  "title": "DSH EAC UI Skin Host Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "regions", "slots", "instanceKinds", "zIndexPolicy", "capabilities", "dshAdapters", "fallbackSkin"],
  "properties": {
    "id": {"const": "dsh-desktop-eac-ui-skin-profile"},
    "version": {"type": "string"},
    "regions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slot"}},
    "instanceKinds": {"type": "array", "items": {"enum": ["popup", "dialog", "floating-window"]}},
    "zIndexPolicy": {"type": "object"},
    "capabilities": {"type": "array", "items": {"type": "object"}},
    "dshAdapters": {"type": "array"},
    "fallbackSkin": {"$ref": "#/$defs/packageCoordinate"}
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["id", "region", "kind", "scope", "propsSchema", "mountContract", "zIndexPolicy", "capabilities", "fallbackSkin"],
      "properties": {
        "id": {"type": "string"}, "region": {"type": "string"}, "kind": {"type": "string"}, "scope": {"type": "string"},
        "propsSchema": {"type": "object"}, "mountContract": {"type": "string"}, "zIndexPolicy": {"type": "object"},
        "capabilities": {"type": "array", "items": {"type": "string"}}, "fallbackSkin": {"type": "string"}
      }
    },
    "packageCoordinate": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
    }
  }
}
