{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-eac.github.io/schemas/ui-skin/v1/host-profile.schema.json",
  "title": "DSH EAC UI Skin Host Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "regions", "slots", "instanceKinds", "zIndexPolicy", "capabilities", "dshAdapters", "fallbackSkin"],
  "properties": {
    "id": {"const": "dsh-desktop-eac-ui-skin-profile"},
    "version": {"$ref": "./skin-package.schema.json#/$defs/semver"},
    "regions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "slots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slot"}},
    "instanceKinds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "zIndexPolicy": {"type": "object", "additionalProperties": {"$ref": "#/$defs/zIndexRange"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "dshAdapters": {"type": "array"},
    "fallbackSkin": {"$ref": "./slot-binding.schema.json#/$defs/packageCoordinate"}
  },
  "$defs": {
    "zIndexRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {"min": {"type": "integer"}, "max": {"type": "integer"}}
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "./skin-package.schema.json#/$defs/identifier"},
        "version": {"$ref": "./skin-package.schema.json#/$defs/semver"}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "region", "kind", "scope", "propsSchema", "mountContract", "zIndexPolicy", "capabilities", "fallbackSkin"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "propsSchema": {"type": "object"},
        "mountContract": {"type": "string", "minLength": 1},
        "zIndexPolicy": {"$ref": "#/$defs/zIndexRange"},
        "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fallbackSkin": {"type": "string", "minLength": 1}
      }
    }
  }
}
